# Local web server. Use 0.0.0.0 so phones on the same WLAN can open it.
APP_HOST=0.0.0.0
APP_PORT=8000

# Optional mDNS browser name for the app on the home network.
# Example URL: http://soundtouch.local:8000
APP_ALIAS_HOST=soundtouch.local

# Optional: set this if discovery does not find the speaker.
SOUNDTOUCH_HOST=
SOUNDTOUCH_PORT=8090
SOUNDTOUCH_DLNA_PORT=8091

# Optional: comma-separated IPs/hosts that must never be contacted.
SOUNDTOUCH_BLOCKLIST=

# Leave off when a blocked speaker is in the same network.
SOUNDTOUCH_ENABLE_SSDP=true

# Optional local password protection for the web UI and API.
# Leave APP_AUTH_PASSWORD empty to disable.
APP_AUTH_USERNAME=admin
APP_AUTH_PASSWORD=

# Optional: set when the speaker must fetch proxied streams from a specific URL.
# Example: http://YOUR_LAN_IP:8000
APP_BASE_URL=
APP_STREAM_BASE_URL=
